{
  "name": "mathmyth-frontend",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "overrides": {
    "katex": "$katex"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "bank:build": "node scripts/compile-question-bank.mjs",
    "knowledge:build": "node scripts/compile-knowledge.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "predesktop:build": "node scripts/copy-pdf-assets.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:run": "electron ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "katex": "^0.18.10",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
